# LedgerFlow local configuration — copy to .env / export in your shell. Never commit real secrets.
DB_URL=jdbc:postgresql://localhost:5432/ledgerflow   # JDBC URL of the PostgreSQL database
DB_USER=ledgerflow                                   # database user (local demo value)
DB_PASSWORD=ledgerflow-local-only                    # database password — CHANGE for any shared deployment
PORT=8080                                            # HTTP port the app listens on
